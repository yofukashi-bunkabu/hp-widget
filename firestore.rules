rules_version = '2';
// 夜更けの地図（site/map/）の守り。Firebase コンソールの Firestore →「ルール」にこの全文を貼って「公開」する。
// ・記録（reviews）は、書いた本人だけが読める・直せる・消せる
// ・「みんなに公開」（visibility == 'public'）の記録は、ログインしていない人も読める（2026-11-18 秋輝の決定）
// ・管理者（admins）はコンソールで手で作る。管理者は公開の記録だけを消せる（自分だけの記録は管理者も読めない）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }

    function validReview(d) {
      return d.keys().hasOnly(['uid','venueId','placeName','lat','lng','date','exhibition','stars','text','visibility','nickname','createdAt','updatedAt'])
        && d.uid == me()
        && (d.venueId == null || str(d.venueId, 1, 40))
        && str(d.placeName, 1, 60)
        && (d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (d.lng == null || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && str(d.date, 0, 10)
        && str(d.exhibition, 0, 80)
        && d.stars is int && d.stars >= 0 && d.stars <= 5
        && str(d.text, 0, 1000)
        && d.visibility in ['private', 'public']
        // 公開には表示名が要る
        && (d.visibility == 'private' || str(d.nickname, 1, 20));
    }

    match /reviews/{id} {
      allow read: if resource.data.visibility == 'public' || (signedIn() && resource.data.uid == me());
      allow create: if signedIn() && validReview(request.resource.data);
      allow update: if signedIn() && resource.data.uid == me() && validReview(request.resource.data);
      allow delete: if signedIn() && (resource.data.uid == me() || (isAdmin() && resource.data.visibility == 'public'));
    }

    match /profiles/{uid} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname', 'updatedAt'])
        && str(request.resource.data.nickname, 1, 20);
    }

    match /admins/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

  }
}
